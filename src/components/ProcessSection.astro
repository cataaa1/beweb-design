---
import SplitLines from "./SplitLines.astro";
import { processSteps } from "@/data/beweb-data";
---

<section id="proceso" class="relative bg-marino-deep py-28 md:py-40">
  <div class="mx-auto max-w-[1440px] px-5 md:px-10">
    <div class="grid grid-cols-12 gap-y-10">
      <h2
        class="col-span-12 text-5xl font-medium leading-[0.95] tracking-[-0.045em] text-crema md:col-span-7 md:text-7xl"
      >
        <SplitLines lines={["Cómo trabajamos"]} />
      </h2>
      <p class="col-span-12 self-end text-base leading-relaxed text-crema/60 md:col-span-4 md:col-start-9">
        Cuatro etapas, un solo equipo de principio a fin. Siempre sabés en qué punto está tu proyecto.
      </p>
    </div>

    <!-- A launch sequence: the rail fills with the scroll (horizontal on desktop, vertical on mobile)
         and each stage lights up as the fill reaches its marker -->
    <ol data-process class="relative mt-20 grid md:mt-28 lg:grid-cols-4">
      <span aria-hidden="true" class="absolute bottom-0 left-[5px] top-0 w-px bg-bruma/15 lg:bottom-auto lg:left-0 lg:right-0 lg:h-px lg:w-auto">
        <span
          data-process-fill
          class="absolute left-0 top-0 block w-px bg-ladrillo lg:h-px lg:w-0"
          style="height: 0%;"></span>
      </span>

      {
        processSteps.map((step) => (
          <li data-process-step data-on="false" class="group relative pb-16 pl-10 last:pb-0 lg:pb-0 lg:pl-0 lg:pr-10 lg:pt-14">
            <span
              data-process-marker
              aria-hidden="true"
              class="absolute left-0 top-2 h-[11px] w-[11px] border border-bruma/40 bg-marino-deep transition-colors duration-500 group-data-[on=true]:border-ladrillo group-data-[on=true]:bg-ladrillo lg:-top-[5px]"
            />
            <span class="mt-2 block text-[88px] font-medium leading-[0.8] tracking-[-0.06em] text-crema/10 transition-colors duration-700 group-data-[on=true]:text-ladrillo lg:text-[120px]">
              {step.index}
            </span>
            <h3 class="mt-8 text-2xl font-medium tracking-[-0.03em] text-crema/40 transition-colors duration-500 group-data-[on=true]:text-crema md:text-3xl">
              {step.title}
            </h3>
            <p class="mt-3 max-w-sm text-base leading-relaxed text-crema/40 transition-colors duration-500 group-data-[on=true]:text-crema/70">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-process]")!;
  const fill = root.querySelector<HTMLElement>("[data-process-fill]")!;
  const steps = [...root.querySelectorAll<HTMLElement>("[data-process-step]")];
  const wide = window.matchMedia("(min-width: 1024px)");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  let queued = false;
  const update = () => {
    queued = false;
    const vh = window.innerHeight;
    const box = root.getBoundingClientRect();
    const h = wide.matches;
    // Desktop: fills while the row travels from 85% to 35% of the viewport height.
    // Mobile: the fill tip follows a reading line at 65% of the viewport.
    let p = h ? clamp((vh * 0.85 - box.top) / (vh * 0.5)) : clamp((vh * 0.65 - box.top) / box.height);
    if (reduce.matches) p = 1;
    // Where each marker sits along the rail, 0–1
    const at = steps.map((s) => {
      const r = s.getBoundingClientRect();
      return h ? (r.left - box.left) / box.width : (r.top - box.top) / box.height;
    });
    fill.style.width = h ? `${p * 100}%` : "";
    fill.style.height = h ? "" : `${p * 100}%`;
    steps.forEach((s, i) => (s.dataset.on = String(p > 0 && p >= at[i])));
  };

  const queue = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };
  window.addEventListener("scroll", queue, { passive: true });
  window.addEventListener("resize", queue);
  wide.addEventListener("change", queue);
  update();
</script>
