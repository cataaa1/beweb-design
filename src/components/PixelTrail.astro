<!-- Page-wide pixel heat trail that follows the mouse (fine pointers only). Sits above the content,
     below the header; the pixel fields draw their own heat, so the trail skips them. -->
<canvas data-pixel-trail aria-hidden="true" class="pointer-events-none fixed inset-0 z-40 h-full w-full"></canvas>

<script>
  import { HeatGrid, heatEnabled } from "@/scripts/heat";

  const CELL = 11;
  const GAP = 1.5;
  // Heat bands, coolest to hottest (craft.wild.as ramp, in BeWeb colours)
  const BANDS: [number, string][] = [
    [0.3, "#3E5C7E"],
    [0.46, "#9CC2E0"],
    [0.62, "#EDE6D8"],
    [0.78, "#B5473A"],
  ];
  const HOT = "#EDE6D8"; // saturated core flips to crema, like wild.as's neon centre

  const canvas = document.querySelector<HTMLCanvasElement>("[data-pixel-trail]")!;
  const ctx = canvas.getContext("2d")!;
  const fields = [...document.querySelectorAll<HTMLCanvasElement>("canvas[data-pixel-field]")];
  const heat = new HeatGrid(CELL);
  let w = 0;
  let h = 0;
  let last = 0;
  let dirty = false;

  const resize = () => {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    heat.resize(w, h);
  };
  resize();
  window.addEventListener("resize", resize);

  const colorFor = (v: number) => {
    if (v >= 0.86 && v < 1.02) return HOT;
    let col = "";
    for (const [min, c] of BANDS) if (v >= min) col = c;
    return col;
  };

  const frame = (time: number) => {
    requestAnimationFrame(frame);
    const dt = last ? Math.min(time - last, 100) : 16.667;
    last = time;
    if (!heatEnabled()) return;
    const warm = heat.update(dt, 0, 0);
    if (!warm && !dirty) return;

    ctx.clearRect(0, 0, w, h);
    dirty = warm;
    if (!warm) return;

    const skip = fields.map((f) => f.getBoundingClientRect()).filter((r) => r.bottom > 0 && r.top < h);
    for (let r = 0; r < heat.rows; r++) {
      const cy = (r + 0.5) * CELL;
      for (let c = 0; c < heat.cols; c++) {
        const v = heat.heat[r * heat.cols + c] * 0.9;
        if (v < 0.3) continue;
        const cx = (c + 0.5) * CELL;
        if (skip.some((b) => cx >= b.left && cx <= b.right && cy >= b.top && cy <= b.bottom)) continue;
        ctx.fillStyle = colorFor(v);
        ctx.fillRect(c * CELL, r * CELL, CELL - GAP, CELL - GAP);
      }
    }
  };
  requestAnimationFrame(frame);
</script>
