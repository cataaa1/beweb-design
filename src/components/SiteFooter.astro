---
import Icon from "./Icon.astro";
import PixelField from "./PixelField.astro";
import BewebLogo from "./BewebLogo.astro";
import { navLinks } from "@/data/beweb-data";
---

<footer class="relative overflow-hidden bg-marino-deep text-crema">
  <div class="relative h-40 md:h-56">
    <PixelField cell={9} speed={0.6} />
  </div>

  <div class="relative mx-auto max-w-[1440px] px-5 md:px-10">
    <!-- The wordmark sits behind everything below as a faint background mark -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 left-3 right-3 flex select-none items-center md:left-10 md:right-10"
    >
      <BewebLogo class="h-auto w-full opacity-[0.12]" />
    </div>

    <!-- Under 360px two columns leave the address too narrow and it gets clipped, so they stack -->
    <div
      class="relative grid grid-cols-1 gap-x-6 gap-y-10 border-t border-bruma/15 py-12 min-[360px]:grid-cols-2 xl:grid-cols-12 xl:gap-10"
    >
      <div class="col-span-1 min-[360px]:col-span-2 xl:col-span-5">
        <p class="max-w-sm text-lg leading-snug text-crema/70">
          Cada proyecto es único. Nos tomamos el tiempo de entender tu negocio para crear soluciones que realmente
          marcan la diferencia.
        </p>
      </div>
      <nav class="xl:col-span-2">
        <ul class="space-y-2">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} class="inline-block py-1 text-sm text-crema/60 transition-colors hover:text-crema">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="space-y-2 text-sm xl:col-span-2">
        <a href="mailto:hola@beweb.com.ar" class="block text-crema/60 transition-colors hover:text-crema">
          hola@beweb.com.ar
        </a>
        <p class="text-crema/60">Respondemos en 24hs hábiles</p>
      </div>
      <div class="col-span-1 flex items-start min-[360px]:col-span-2 xl:col-span-3 xl:justify-end">
        <a
          href="#top"
          class="group flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-crema/60 hover:text-crema"
        >
          Volver arriba
          <span
            class="grid h-9 w-9 place-items-center border border-crema/25 transition-colors group-hover:border-ladrillo group-hover:bg-ladrillo"
          >
            <Icon name="arrow-up" class="h-3.5 w-3.5" />
          </span>
        </a>
      </div>
    </div>

    <div
      class="relative flex flex-col justify-between gap-2 pb-8 pt-10 font-mono text-[10px] uppercase tracking-[0.14em] text-crema/60 md:flex-row md:pt-28"
    >
      <span>© {new Date().getFullYear()} BeWeb · Agencia de diseño y desarrollo web</span>
      <span>Mar del Plata, Argentina</span>
    </div>
  </div>
</footer>
