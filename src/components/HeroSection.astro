---
import Icon from "./Icon.astro";
import PixelField from "./PixelField.astro";
import DeployTicker from "./DeployTicker.astro";
import SplitLines from "./SplitLines.astro";
import Reveal from "./Reveal.astro";

const PHRASES = [
  "Sitios institucionales que comuniquen tu marca",
  "Landing pages rápidas y efectivas",
  "Tiendas online que vendan 24/7",
  "¿Estás listo?",
];
---

<section id="top" class="relative overflow-hidden bg-marino pb-16 pt-16 md:pb-24">
  <div class="mx-auto grid max-w-[1440px] grid-cols-12 px-5 md:px-10">
    <h1
      class="col-span-12 pb-10 pt-14 text-[15vw] font-medium uppercase leading-[0.86] tracking-[-0.055em] text-crema md:col-span-8 md:pb-14 md:pt-20 md:text-[8.6vw] xl:text-[128px]"
    >
      <SplitLines lines={["Webs que", "despegan."]} />
      <span class="sr-only">BeWeb, agencia de diseño y desarrollo web en Mar del Plata</span>
    </h1>

    <div class="col-span-12 border-t border-bruma/20 pb-10 pt-8 md:col-span-4 md:my-16 md:flex md:items-center md:border-l md:border-t-0 md:pb-0 md:pl-10 md:pt-0">
      <Reveal delay={250} class="w-full">
        <!-- Rotating phrases: each one slides up into view, holds, then slides out (scripts below) -->
        <p
          data-rotator
          class="relative h-[3.3em] max-w-[440px] overflow-hidden text-3xl font-medium leading-[1.08] tracking-[-0.035em] text-crema lg:text-[34px] xl:text-[40px]"
        >
          {
            PHRASES.map((phrase, i) => (
              <span
                data-phrase
                class:list={[
                  "absolute inset-0 flex items-center transition-[transform,opacity] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]",
                  i === PHRASES.length - 1 && "text-bruma",
                ]}
                style={i === 0 ? "" : "transform: translateY(110%); opacity: 0;"}
              >
                {phrase}
              </span>
            ))
          }
        </p>
      </Reveal>
    </div>
  </div>

  <div class="relative h-[58vh] min-h-[380px] w-full md:h-[64vh]">
    <PixelField />
    <div class="pointer-events-none absolute inset-0 bw-grid-bg"></div>

    <div class="absolute right-5 top-6 hidden md:right-10 md:block bw-float">
      <DeployTicker />
    </div>

    <a
      href="#proyectos"
      class="absolute bottom-6 left-5 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-crema/70 transition-colors hover:text-crema md:left-10"
    >
      <span class="grid h-9 w-9 place-items-center border border-crema/30 bg-marino/60 backdrop-blur">
        <Icon name="arrow-down" class="h-3.5 w-3.5" />
      </span>
      Ver proyectos
    </a>
  </div>
</section>

<script>
  const HOLD_MS = 2600;
  const rotator = document.querySelector<HTMLElement>("[data-rotator]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (rotator && !reduce) {
    const phrases = [...rotator.querySelectorAll<HTMLElement>("[data-phrase]")];
    let current = 0;
    const place = (el: HTMLElement, y: string, opacity: string, animate = true) => {
      el.style.transition = animate ? "" : "none";
      el.style.transform = `translateY(${y})`;
      el.style.opacity = opacity;
    };
    setInterval(() => {
      const out = phrases[current];
      current = (current + 1) % phrases.length;
      const next = phrases[current];
      // next waits below the mask, then both move up together
      place(next, "110%", "0", false);
      void next.offsetHeight;
      place(out, "-110%", "0");
      place(next, "0", "1");
    }, HOLD_MS);
  }
</script>
